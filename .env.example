# These variables are only available locally in MiniOxygen
PUBLIC_CHECKOUT_DOMAIN=checkout.hydrogen.shop
PRIVATE_STOREFRONT_API_TOKEN="your_private_storefront_api_here" # e.g. shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_STOREFRONT_API_TOKEN="your_public_storefront_api_here"
PUBLIC_STORE_DOMAIN="your_store_domain_here" # e.g. hydrogen-preview.myshopify.com
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID="your_customer_account_api_client_id_here" # e.g. shp_ad7f793c-461f-4cec-bf1b-3bd6e26afc88
PUBLIC_CUSTOMER_ACCOUNT_API_URL="https://shopify.com/xxxxxxxxxx" # e.g. https://shopify.com/68849271039
SESSION_SECRET="foobar"
PUBLIC_STOREFRONT_ID="foobar"

# ============================================================================
# CONFIGURACIÓN DE COLORES DE PRODUCTOS (IMPORTANTE)
# ============================================================================
# Estas variables son necesarias para mostrar imágenes de colores de productos
# Sigue estos pasos para obtener los valores:
#
# 1. Ve a: Shopify Admin → Contenido → Archivos
# 2. Sube una imagen de prueba
# 3. Copia el enlace de la imagen, ejemplo:
#    https://cdn.shopify.com/s/files/1/0586/7674/0198/files/test.png?v=123456789
# 4. Extrae la URL base (elimina el nombre del archivo):
#    https://cdn.shopify.com/s/files/1/0586/7674/0198/files/
# 5. Asegúrate que termine con "/" y empiece con "https://"
#
# IMPORTANTE: Para productos con variantes de color:
# - Si tienes un color llamado "Red", sube una imagen llamada: Red.png
# - Si tienes "Pink and White", sube: Pink_and_White.png (espacios = guiones bajos)
# - El formato debe coincidir con PUBLIC_IMAGE_FORMAT_FOR_PRODUCT_OPTION
# ============================================================================
PUBLIC_STORE_CDN_STATIC_URL="https://cdn.shopify.com/s/files/1/0586/7674/0198/files/"
PUBLIC_IMAGE_FORMAT_FOR_PRODUCT_OPTION='png'  # Opciones: png/jpg/jpeg/webp/svg
SHOP_ID=1234567890
# OKENDO API (Optional)
PUBLIC_OKENDO_SUBSCRIBER_ID = "your_okendo_subscriber_id_here" # e.g. '0ddd53c2-21a9-455d-bf58-10e9355089ae
